# Vireo Audio Support Intelligence - Environment Configuration
# Copy this file to .env and configure your desired providers and keys.

# Provider Priority Configuration (comma-separated for fallbacks)
# Available providers: gemini, groq, xai, nemotron, local
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,nemotron,local

# API Credentials (never commit real keys to git)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_grok_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Configurable Model Overrides (defaults to active working models)
GEMINI_MODEL=gemma-4-26b-a4b-it
GROQ_MODEL=qwen/qwen3.8-27b
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Operational Safeguards
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
